# Indian Anime Club clean article URLs.
# Apache/LiteSpeed hosting can serve flat articles/slug.html files at /slug/.
RewriteEngine On

# Keep clean URLs for the static information pages backed by root-level HTML files.
# Redirect direct .html requests to the canonical slash URL, then serve the clean route.
RewriteCond %{THE_REQUEST} \s/+((about|contact|community-guidelines|editorial-policy|privacy-policy|terms|disclaimer|leadership))\.html(?:[\s?]) [NC]
RewriteRule ^(about|contact|community-guidelines|editorial-policy|privacy-policy|terms|disclaimer|leadership)\.html$ /$1/ [R=301,L,NE]

RewriteRule ^about/?$ about.html [L]
RewriteRule ^contact/?$ contact.html [L]
RewriteRule ^community-guidelines/?$ community-guidelines.html [L]
RewriteRule ^editorial-policy/?$ editorial-policy.html [L]
RewriteRule ^privacy-policy/?$ privacy-policy.html [L]
RewriteRule ^terms/?$ terms.html [L]
RewriteRule ^disclaimer/?$ disclaimer.html [L]
RewriteRule ^leadership/?$ leadership.html [L]

# Redirect explicit article .html URLs to the established clean root URL.
RewriteCond %{THE_REQUEST} \s/+articles/([^/?]+)\.html(?:[\s?]) [NC]
RewriteRule ^articles/([^/]+)\.html$ /$1/ [R=301,L,NE]

# Serve the CURRENT flat article source for each canonical clean URL.
# Do not exclude existing directories: older /slug/index.html folders can shadow
# updated articles/slug.html after a hosting migration or stale deployment.
# The article-source -f condition prevents unrelated routes being affected.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_URI} ^/([^/]+)/?$
RewriteCond %{DOCUMENT_ROOT}/articles/%1.html -f
RewriteRule ^([^/]+)/?$ articles/$1.html [L]

# Keep shared behaviour and search-index files fresh after GitHub deployments.
# LiteSpeed/Apache honours these headers when mod_headers is enabled.
<IfModule mod_headers.c>
  <FilesMatch "^(site-shell|site-fixes)\\.js$">
    Header set Cache-Control "no-cache, must-revalidate, max-age=0"
  </FilesMatch>
  <FilesMatch "^(sitemap|sitemap_index)\\.xml$">
    Header set Cache-Control "no-cache, must-revalidate, max-age=0"
  </FilesMatch>
  # Article HTML is revalidated so CDN/browser caches cannot retain an old
  # 1200px feature layout after the source has been updated.
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate, max-age=0"
  </FilesMatch>
</IfModule>
